INCOMING_PATH=/mnt/data/romm/import/incoming
PROCESSING_PATH=/mnt/data/romm/import/processing
QUARANTINE_PATH=/mnt/data/romm/import/quarantine
REPORTS_PATH=/mnt/data/romm/import/reports
DATS_PATH=/mnt/data/romm/import/dats
APPDATA_PATH=/mnt/data/romm/appdata/importer
LIBRARY_ROMS_PATH=/mnt/data/romm/library/roms
LIBRARY_BIOS_PATH=/mnt/data/romm/library/bios
ADMIN_USERNAME=admin
# Generate with: docker compose run --rm romm-importer romm-importer hash-password
ADMIN_PASSWORD_HASH=
# Generate a 32+ byte random value, e.g. openssl rand -hex 32
SESSION_SECRET=
COOKIE_SECURE=false
ROMM_URL=http://10.0.1.20:30061
ROMM_API_TOKEN=
# Request and task-poll limits for RomM API integration.
ROMM_REQUEST_TIMEOUT_SECONDS=20
ROMM_SCAN_TIMEOUT_SECONDS=1800
MAX_ARCHIVE_ENTRIES=5000
MAX_ARCHIVE_FILE_BYTES=4294967296
MAX_ARCHIVE_TOTAL_BYTES=8589934592
# Node.js heap reserved for Igir; must remain below the 2 GiB container limit.
IGIR_MAX_OLD_SPACE_MB=1400
